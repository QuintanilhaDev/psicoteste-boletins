# Copie estes nomes para Vercel → Project → Settings → Environment Variables.
# NUNCA coloque os valores reais no GitHub.

# Senha que o sistema pede uma vez em cada aparelho (obrigatória para nota e e-mail). Use uma senha longa.
SENHA_DO_APP=

# --- Nota fiscal (NFS-e Salvador) ---
# Certificado digital A1 (.pfx) convertido para texto base64 (ver README) e a senha dele.
NFSE_CERT_PFX_BASE64=
NFSE_CERT_SENHA=
# homologacao = notas de teste, sem valor fiscal | producao = notas de verdade
NFSE_AMBIENTE=homologacao

# --- E-mail (SMTP) ---
# Gmail: smtp.gmail.com / 465 / o endereço / uma "senha de app" (não a senha normal)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcionais: endereço que aparece como remetente e uma cópia oculta de tudo que sai
EMAIL_REMETENTE=
EMAIL_COPIA=

# --- Supabase (opcional: mesmos dados no computador e no celular) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
